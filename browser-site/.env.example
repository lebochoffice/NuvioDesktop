# Supply the *public* Supabase project URL and publishable/anon key
# for the Nuvio backend that hosts the party. Do not use a service-role key.
# These settings are embedded into the public web build.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional, diagnosis builds only (e.g. a Cloudflare Preview): set to 1 to show
# shared browser pause/resume. Never set in Production until the backend
# authorization of watch_party_update for guests is confirmed.
# VITE_PARTY_GUEST_CONTROL=1
