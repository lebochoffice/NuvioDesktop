# Supply the *public* Supabase project URL and publishable/anon key
# for the Nuvio backend that hosts the party. Do not use a service-role key.
# These settings are embedded into the public web build.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Shared browser control when the host allows guests (host_only=false):
#   unset or "desktop" = like Nuvio Desktop guests (broadcast, then persist)
#   "confirmed" (or 1)  = only after watch_party_update returned the command
#   "off"               = local player controls only
# VITE_PARTY_GUEST_CONTROL=desktop
