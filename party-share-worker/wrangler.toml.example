# Copy to wrangler.toml and deploy yourself (not deployed by this repository).
# Only public values here; the TorBox key never lives in the Worker config.
name = "nuvio-party-share"
main = "src/index.js"
compatibility_date = "2026-10-01"
workers_dev = true

[vars]
# Same public backend as the Desktop/browser build (publishable or anon key only).
SUPABASE_URL = "https://api.nuvio.tv"
SUPABASE_ANON_KEY = "sb_publishable_REPLACE_ME"
# Browser pages that may call /v1/grant and /v1/stream (comma separated, exact origins).
ALLOWED_ORIGINS = "https://feature-party-premium-ui.nuvio-watch-friends.pages.dev"

[[durable_objects.bindings]]
name = "PARTY_SHARE"
class_name = "PartyShare"

# Workers Rate Limiting API (per client IP and action; period 10 or 60 s).
# namespace_id: any positive integer unique within your Cloudflare account.
# Budgets leave room for a whole family behind one home IP reconnecting:
# a reconnect uses /v1/stream; /v1/grant is needed only every 5 min per guest.
[[ratelimits]]
name = "SHARE_RATE_LIMIT"
namespace_id = "46001"
simple = { limit = 10, period = 60 }

[[ratelimits]]
name = "GRANT_RATE_LIMIT"
namespace_id = "46002"
simple = { limit = 30, period = 60 }

[[ratelimits]]
name = "STREAM_RATE_LIMIT"
namespace_id = "46003"
simple = { limit = 60, period = 60 }

[[migrations]]
tag = "v1"
new_sqlite_classes = ["PartyShare"]

# No logpush and no tail consumers: request bodies carry the share address.
[observability]
enabled = false
